# Copy this file to ".env" and fill in the values. Never share or commit ".env".

# --- Admin login (open /admin in the browser) ---
ADMIN_USERNAME=admin
# Choose a strong password (8+ characters). Admin login stays disabled until you change this.
ADMIN_PASSWORD=change-me-please

# --- Owner WhatsApp number (digits, international format, e.g. 923131498344) ---
# You can also change this from Admin > "WhatsApp & Excel" -> Save (it rewrites this line).
OWNER_WHATSAPP=923131498344

# --- Optional ---
# PORT=3000
# DATA_DIR=data
# SESSION_SECRET=any-long-random-string   (auto-generated into data/.session-secret when empty)

# Optional Neon PostgreSQL connection string (server-side only; never expose as VITE_*).
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
